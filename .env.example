# BloodChain AI — Environment Variables
# Copy this to .env and fill in your values.

# ============================================================
# Firebase (Frontend)
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# Backend
# ============================================================
PORT=3001
NODE_ENV=development

# PostgreSQL (server-side only — NEVER expose in frontend code)
DATABASE_URL=postgresql://user:password@localhost:5432/bloodchain
PGHOST=localhost
PGPORT=5432
PGDATABASE=bloodchain
PGUSER=user
PGPASSWORD=password

# ML Service
ML_SERVICE_URL=http://localhost:8000

# ============================================================
# ML Service (Python)
# ============================================================
ML_PORT=8000
DATASET_DIR=datasets/synthetic
MODEL_ARTIFACTS_DIR=model-artifacts
