# Django Environment Variables Template
# Copy to .env for local development

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-development-secret-key-bloodchain-2026
DATABASE_ENGINE=sqlite
DATABASE_URL=
ML_SERVICE_URL=http://127.0.0.1:8001

# React / Vite Environment Variables
VITE_API_URL=http://localhost:8000
VITE_DATA_MODE=demo

# Brevo Transactional Email API (Direct HTTPS Integration)
# Keep BREVO_INTEGRATION_ENABLED=false for local development / test simulation mode
BREVO_API_KEY=your-brevo-api-key-placeholder
BREVO_SENDER_EMAIL=your-verified-brevo-sender@yourdomain.com
BREVO_SENDER_NAME=BloodChain AI Emergency Notifications
BREVO_INTEGRATION_ENABLED=false


